# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.
# NEVER put real values in this file - it gets pushed to GitHub.
#
# How to create it on Windows PowerShell:
#   Copy-Item .env.example .env
#   notepad .env

# --- Supabase (fill in when we set up the database) ---s
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Gemini AI (fill in when we set up AI features) ---
GEMINI_API_KEY=

SUPABASE_USER_EMAIL=
SUPABASE_USER_PASSWORD=