# Template with PLACEHOLDERS ONLY.
# Copy to .env (real values live there, NEVER here) — .env is git-ignored.
# The pre-commit hook blocks commits that contain real values in this file.

# --- Supabase (fill in when we set up the database) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_USER_EMAIL=
SUPABASE_USER_PASSWORD=

# --- Gemini AI (optional; the app is honest when this is missing) ---
GEMINI_API_KEY=

# --- Optional overrides ---
# GEMINI_MODEL=gemini-2.5-flash
# TIMEZONE=Asia/Kolkata          # IANA name; sets the app's daily boundary
